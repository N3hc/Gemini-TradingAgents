# Copy to .env (the installer does it) and fill in. Never commit .env.
# Only one Gemini API key needed: Neon, Hydrogen, Argon and Carbon all use it. Get it at aistudio.google.com.
GEMINI_API_KEY=

# Optional: ai-hedge-fund needs market data from financialdatasets.ai (or an x402 wallet). Without it, that stage is skipped.
FINANCIAL_DATASETS_API_KEY=
# Optional: TradingAgents uses a Tauric key for filings, statements and news (tauric.ai).
TAURIC_API_KEY=
# Optional: Alpaca PAPER trading (free account at alpaca.markets). Paper keys only.
ALPACA_KEY=
ALPACA_SECRET=
# Optional: symbols for `gemini-tradingagents bot` when none are given on the command line
# GD_WATCHLIST=AAPL,MSFT,NVDA
# GD_WATCHLIST=auto            (today's picks from `gemini-tradingagents screen`)

# Optional: technical screen for GD_WATCHLIST=auto (defaults shown; universe = mandates/universe.txt)
# GD_UNIVERSE=mandates/universe.txt
# GD_SCREEN_TOP=3
# GD_SCREEN_MIN_PRICE=5
# GD_SCREEN_MIN_DOLLAR_VOLUME=20000000
# GD_SCREEN_RSI_MIN=40
# GD_SCREEN_RSI_MAX=70
# GD_SCREEN_MAX_VOL_PCT=60

# Optional: move a job to another model
# GD_MODEL_COLLECTOR=gemini-4-hydrogen
# GD_MODEL_ANALYST=gemini-4-argon
# GD_MODEL_STRATEGIST=gemini-4-neon
# GD_MODEL_JUDGE=gemini-4-carbon
# GD_NEON_REASONING=high
# GD_STAGE_TIMEOUT=900

# Optional hard limits (defaults shown)
# GD_MAX_RISK_PCT=1.0
# GD_MAX_POSITION_PCT=20
# GD_MIN_REWARD_RISK=1.5
# GD_MIN_STOP_ATR=0.5
# GD_MAX_ENTRY_GAP_PCT=3
# GD_MAX_DAILY_LOSS_PCT=2
# GD_KILL_SWITCH=KILL
